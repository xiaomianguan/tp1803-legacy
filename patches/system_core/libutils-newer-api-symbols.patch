+++ b/libutils/compat_newer_apis.cpp
@@ -0,0 +1,15 @@
+/* Symbols newer (Android 7+) prebuilt HALs expect from libutils. Kept out of
+ * String16.cpp: String16::size() is inline in this tree's header. */
+#include <utils/Log.h>
+#include <utils/SharedBuffer.h>
+
+namespace android {
+// Called by sp<> when it detects a racy assignment.
+void sp_report_race() { LOG_ALWAYS_FATAL("sp<> assignment detected data race"); }
+}
+
+// size_t String16::size() const (String16 holds one pointer, into a SharedBuffer)
+extern "C" size_t _ZNK7android8String164sizeEv(const char16_t* const* self)
+{
+    return android::SharedBuffer::sizeFromData(*self) / sizeof(char16_t) - 1;
+}
