diff --git a/libc/bionic/compat_newer_apis.cpp b/libc/bionic/compat_newer_apis.cpp
new file mode 100644
index 000000000..0cadcc255
--- /dev/null
+++ b/libc/bionic/compat_newer_apis.cpp
@@ -0,0 +1,68 @@
+/*
+ * Functions newer (P/Q-era) prebuilt blobs import that Android 6's bionic
+ * lacks. Added for the TP1803 port's Qualcomm CamX camera HAL.
+ */
+#include <locale.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "private/libc_logging.h"
+
+static bool mul_overflows(size_t a, size_t b, size_t* out) {
+  if (a != 0 && b > static_cast<size_t>(-1) / a) return true;
+  *out = a * b;
+  return false;
+}
+
+extern "C" size_t __fread_chk(void* buf, size_t size, size_t count, FILE* stream, size_t buf_size) {
+  size_t total;
+  if (mul_overflows(size, count, &total) || total > buf_size) {
+    __fortify_chk_fail("fread: prevented write past end of buffer", 0);
+  }
+  return fread(buf, size, count, stream);
+}
+
+extern "C" size_t __fwrite_chk(const void* buf, size_t size, size_t count, FILE* stream,
+                               size_t buf_size) {
+  size_t total;
+  if (mul_overflows(size, count, &total) || total > buf_size) {
+    __fortify_chk_fail("fwrite: prevented read past end of buffer", 0);
+  }
+  return fwrite(buf, size, count, stream);
+}
+
+extern "C" ssize_t __write_chk(int fd, const void* buf, size_t count, size_t buf_size) {
+  if (count > buf_size) {
+    __fortify_chk_fail("write: prevented read past end of buffer", 0);
+  }
+  return write(fd, buf, count);
+}
+
+extern "C" char* fgets_unlocked(char* buf, int n, FILE* stream) {
+  return fgets(buf, n, stream);
+}
+
+// Android 9 stdio additions used by the stock audio calibration blobs
+// (libacdbloader closure). M's stdio locks internally; the plain calls are
+// a correct (if slower) implementation of the unlocked variants.
+extern "C" int fgetc_unlocked(FILE* stream) {
+  return fgetc(stream);
+}
+
+extern "C" size_t fread_unlocked(void* buf, size_t size, size_t count, FILE* stream) {
+  return fread(buf, size, count, stream);
+}
+
+extern "C" size_t fwrite_unlocked(const void* buf, size_t size, size_t count, FILE* stream) {
+  return fwrite(buf, size, count, stream);
+}
+
+// Bionic only supports the C locale, so the _l variants ignore the locale.
+extern "C" double strtod_l(const char* s, char** end, locale_t) {
+  return strtod(s, end);
+}
+
+extern "C" float strtof_l(const char* s, char** end, locale_t) {
+  return strtof(s, end);
+}
diff --git a/libc/libc.map b/libc/libc.map
index 47c52a40f..6479f9e77 100644
--- a/libc/libc.map
+++ b/libc/libc.map
@@ -1454,3 +1454,25 @@ LIBC_PRIVATE {
     SHA1Transform; # arm x86 mips
     SHA1Update; # arm x86 mips
 } LIBC;
+
+# TP1803: versions newer prebuilt blobs (CamX) bind to.
+LIBC_N {
+  global:
+    __fread_chk; # TP1803: newer blob compat (N)
+    __fwrite_chk;
+    __write_chk; # TP1803: newer blob compat (N)
+} LIBC;
+
+LIBC_O {
+  global:
+    strtod_l;
+    strtof_l;
+} LIBC_N;
+
+LIBC_P {
+  global:
+    fgetc_unlocked;
+    fgets_unlocked;
+    fread_unlocked;
+    fwrite_unlocked;
+} LIBC_O;
