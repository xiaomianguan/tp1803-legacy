diff --git a/audio_route/audio_route.c b/audio_route/audio_route.c
index d24f779..ad6a1f9 100644
--- a/audio_route/audio_route.c
+++ b/audio_route/audio_route.c
@@ -325,6 +325,13 @@ static int path_add_path(struct audio_route *ar, struct mixer_path *path,
 {
     unsigned int i;
 
+    /* Newer mixer_paths files reference paths this parser could not resolve
+     * (or nest them at top level): skip instead of dereferencing NULL. */
+    if (!path || !sub_path) {
+        ALOGE("path_add_path: unresolved path reference - skipping");
+        return 0;
+    }
+
     for (i = 0; i < sub_path->length; i++)
         if (path_add_setting(ar, path, &sub_path->setting[i]) < 0)
             return -1;
