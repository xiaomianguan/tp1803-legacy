diff --git a/src/freedreno/drm/kgsl/kgsl_bo.c b/src/freedreno/drm/kgsl/kgsl_bo.c
index 6e41245..3e2d1aa 100644
--- a/src/freedreno/drm/kgsl/kgsl_bo.c
+++ b/src/freedreno/drm/kgsl/kgsl_bo.c
@@ -1,4 +1,5 @@
 #include "kgsl_priv.h"
+#include "util/simple_mtx.h"
 #include "util/os_mman.h"
 
 static uint64_t
@@ -38,28 +39,85 @@ kgsl_bo_cpu_prep(struct fd_bo *bo, struct fd_pipe *pipe, uint32_t op)
     return 0;
 }
 
+/*
+ * KGSL frees a GPU object (and tears down its IOMMU mapping) as soon as it is
+ * freed, unlike msm GEM which keeps it alive while referenced by in-flight
+ * submits. Userspace fence bookkeeping can consider a BO idle slightly before
+ * the CCU has finished flushing into it, which showed up as "premature free"
+ * GPU page faults on window buffers. Defer every free until the most recently
+ * submitted timestamp retires instead.
+ */
+#define KGSL_MAX_TRACKED_CTX 8
+static simple_mtx_t submit_lock = SIMPLE_MTX_INITIALIZER;
+static struct { uint32_t ctx, ts; } last_submit[KGSL_MAX_TRACKED_CTX];
+static unsigned last_submit_count, last_submit_newest;
+
+void
+kgsl_note_submit(uint32_t context_id, uint32_t timestamp)
+{
+    simple_mtx_lock(&submit_lock);
+    unsigned i;
+    for (i = 0; i < last_submit_count; i++)
+        if (last_submit[i].ctx == context_id)
+            break;
+    if (i == last_submit_count) {
+        if (last_submit_count < KGSL_MAX_TRACKED_CTX)
+            last_submit_count++;
+        else
+            i = (last_submit_newest + 1) % KGSL_MAX_TRACKED_CTX;
+    }
+    last_submit[i].ctx = context_id;
+    last_submit[i].ts = timestamp;
+    last_submit_newest = i;
+    simple_mtx_unlock(&submit_lock);
+}
+
 void
 kgsl_bo_close_handle(struct fd_bo *bo)
 {
-    struct kgsl_gpumem_free_id req = {
-        .id = bo->handle
-    };
+    struct kgsl_gpu_event_timestamp ev = { 0 };
+    bool deferred = false;
+
+    simple_mtx_lock(&submit_lock);
+    for (unsigned i = 0; i < last_submit_count; i++) {
+        if (i == last_submit_newest)
+            continue;
+        /* Rare: other contexts in this process. Wait for them directly. */
+        struct kgsl_device_waittimestamp_ctxtid w = {
+            .context_id = last_submit[i].ctx,
+            .timestamp = last_submit[i].ts,
+            .timeout = 2000,
+        };
+        kgsl_pipe_safe_ioctl(bo->dev->fd, IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID, &w);
+    }
+    if (last_submit_count) {
+        ev.context_id = last_submit[last_submit_newest].ctx;
+        ev.timestamp = last_submit[last_submit_newest].ts;
+        deferred = true;
+    }
+    simple_mtx_unlock(&submit_lock);
 
-    kgsl_pipe_safe_ioctl(bo->dev->fd, IOCTL_KGSL_GPUMEM_FREE_ID, &req);
+    struct kgsl_gpuobj_free req = {
+        .id = bo->handle,
+    };
+    if (deferred) {
+        req.flags = KGSL_GPUOBJ_FREE_ON_EVENT;
+        req.type = KGSL_GPU_EVENT_TIMESTAMP;
+        req.priv = (uint64_t)(uintptr_t)&ev;
+        req.len = sizeof(ev);
+    }
+    if (kgsl_pipe_safe_ioctl(bo->dev->fd, IOCTL_KGSL_GPUOBJ_FREE, &req) && deferred) {
+        /* Context already gone or event rejected: plain free. */
+        struct kgsl_gpumem_free_id f = { .id = bo->handle };
+        kgsl_pipe_safe_ioctl(bo->dev->fd, IOCTL_KGSL_GPUMEM_FREE_ID, &f);
+    }
 }
 
 static void
 kgsl_bo_destroy(struct fd_bo *bo)
 {
-    /* KGSL will immediately delete the BO when we close
-     * the handle, so wait on all fences to ensure
-     * the GPU is done using it before we destory it
-     */
-    for (uint32_t i = 0; i < bo->nr_fences; i++) {
-        struct fd_pipe *pipe = bo->fences[i]->pipe;
-        pipe->funcs->wait(pipe, bo->fences[i], ~0);
-    }
-
+    /* The GPU object itself is freed on a timestamp event (see
+     * kgsl_bo_close_handle), so there is no need to stall the CPU here. */
     fd_bo_fini_common(bo);
 }
 
