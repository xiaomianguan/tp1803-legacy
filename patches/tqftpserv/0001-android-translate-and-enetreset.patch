+/* Downstream (PIL) Qualcomm kernels have no remoteproc class: look in the
+ * firmware partition mount and vendor firmware directly first. */
+static int translate_readonly(const char *file)
+{
+	static const char *const dirs[] = { "/firmware/image/", "/vendor/firmware/", "/firmware/", NULL };
+	char path[PATH_MAX];
+	int d, fd;
+
+	for (d = 0; dirs[d]; d++) {
+		if (strlen(dirs[d]) + strlen(file) + 1 > sizeof(path))
+			continue;
+		snprintf(path, sizeof(path), "%s%s", dirs[d], file);
+		fd = open(path, O_RDONLY);
+		if (fd >= 0)
+			return fd;
+	}
+	return translate_readonly_rproc(file);
+}
