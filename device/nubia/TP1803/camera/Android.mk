LOCAL_PATH := $(call my-dir)

# HAL 3.5 -> 3.3 wrapper around CamX (wrapper/camera_wrapper.c)
include $(CLEAR_VARS)
LOCAL_MODULE := camera.tp1803
LOCAL_MODULE_RELATIVE_PATH := hw
LOCAL_MULTILIB := 64
LOCAL_SRC_FILES := wrapper/camera_wrapper.c
LOCAL_CFLAGS := -std=gnu99 -Wall -Werror -Wno-unused-parameter
LOCAL_SHARED_LIBRARIES := liblog libcutils libdl libcamera_metadata
LOCAL_C_INCLUDES := system/media/camera/include
LOCAL_MODULE_TAGS := optional
include $(BUILD_SHARED_LIBRARY)

# Stand-ins for two stock vendor libraries CamX links against (see shims/*.c)
include $(CLEAR_VARS)
LOCAL_MODULE := libqdMetaData
LOCAL_MODULE_PATH_64 := $(TARGET_OUT_VENDOR)/lib64
LOCAL_MODULE_PATH_32 := $(TARGET_OUT_VENDOR)/lib
LOCAL_MULTILIB := both
LOCAL_SRC_FILES := shims/qdmetadata_stub.c
LOCAL_MODULE_TAGS := optional
include $(BUILD_SHARED_LIBRARY)

include $(CLEAR_VARS)
LOCAL_MODULE := libcdsprpc
LOCAL_MODULE_PATH_64 := $(TARGET_OUT_VENDOR)/lib64
LOCAL_MULTILIB := 64
LOCAL_SRC_FILES := shims/cdsprpc_stub.c
LOCAL_MODULE_TAGS := optional
include $(BUILD_SHARED_LIBRARY)

# No-op stand-ins for the HIDL/VPP libraries the CHI override links against
# (generated by tools/camera/gen-stubs.py; the VPP service never exists here).
define camx-hidl-stub
include $$(CLEAR_VARS)
LOCAL_MODULE := $(1)
LOCAL_MODULE_PATH_64 := $$(TARGET_OUT_VENDOR)/lib64
LOCAL_MULTILIB := 64
LOCAL_SRC_FILES := shims/hidl/$(1).S
LOCAL_MODULE_TAGS := optional
include $$(BUILD_SHARED_LIBRARY)
endef
$(foreach l,libhidlbase libhidltransport vendor.qti.hardware.vpp@1.1 vendor.qti.hardware.vpp@1.2,\
    $(eval $(call camx-hidl-stub,$(l))))
